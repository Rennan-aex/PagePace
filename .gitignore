# dependencies / build
node_modules/
dist/
coverage/
*.tsbuildinfo
.pagepace-cache/

# env / editor / OS
.env
.env.*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# PDFs NEVER go to git, with one exception: the two vendored SciELO fixtures
# whose source blocks the CI (copied byte for byte, verified by check:no-pdf).
*.pdf
corpus/public/*
!corpus/public/.gitkeep
!corpus/vendored/*.pdf

# eval outputs (generated)
packages/eval/out/
