{
  "name": "pagepace",
  "private": true,
  "version": "0.0.0",
  "description": "PagePace monorepo: PDF-to-reflow extractor, segmenter, eval harness and the reader app.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:no-pdf": "bash scripts/check-no-pdf.sh",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:no-pdf",
    "pagepace": "tsx packages/cli/src/main.ts",
    "corpus:fetch": "tsx packages/eval/src/fetch.ts",
    "eval": "echo 'not implemented yet: task E1-T08' && exit 1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
