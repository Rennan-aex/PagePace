{
  "name": "pagepace",
  "private": true,
  "version": "0.0.0",
  "description": "PagePace monorepo: PDF-to-reflow extractor, segmenter, eval harness and the reader app.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:no-pdf": "bash scripts/check-no-pdf.sh",
    "check:docs": "node scripts/check-docs-budget.mjs",
    "decisions:index": "node scripts/build-decisions-index.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:no-pdf && pnpm check:docs",
    "pagepace": "tsx packages/cli/src/main.ts",
    "corpus:fetch": "tsx packages/eval/src/fetch.ts",
    "corpus:synthetic": "tsx packages/eval/src/synthetic-cli.ts",
    "eval": "tsx packages/eval/src/eval.ts",
    "bench": "tsx packages/eval/src/bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@napi-rs/canvas": "^1.0.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@types/node": "^22.0.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
